// types1
//
// `type` declares a record: named, typed fields, separated by commas.
// Create one with `Point { x: 1, y: 2 }`. Methods live inside the type body
// and read fields through `this`.

type Rectangle {
    i32 width,
    i32 height,

    i32 Area() {
        return this.width * this.height;
    }
}

test area_of_rectangle {
    Rectangle box = Rectangle { width: 3, height: 4 };
    Testing.Assert.Equal(box.Area(), 12, "3 * 4");
}
