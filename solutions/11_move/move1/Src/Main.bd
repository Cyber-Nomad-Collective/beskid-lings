// move1
//
// Arrays and lists are Moved values: they have one owner at a time. In
// ordinary code you pass them around freely. When one crosses to another
// isolate, for example into a parallel task, ownership is handed over, and
// you say so with `move`: `s.Spawn(() => Total(move scores))`. After that the
// array belongs to the task, and the caller must not use it again.

use Core.Collections.Array;
use Core.Parallel;
use Core.Parallel.Scopes;
use Core.Results;

i64 Total(i64[] scores)
{
    mut i64 total = 0;
    for score in scores
    {
        total += score;
    }
    return total;
}

/// Sums the scores on another isolate, then adds how many there were.
i64 TotalPlusCount()
{
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Core.Parallel.Scopes.Scope s) => {
        i64[] scores = [3, 4, 5];
        i64 count = Array.Len<i64>(scores);
        Task<i64> task = s.Spawn(() => Total(move scores));
        return match (task.Join())
        {
            Result::Ok(total) => Result::Ok(total + count),
            Result::Error(_) => Result::Error(ParallelError::Cancelled),
        };
    });
    return match (result)
    {
        Result::Ok(value) => value,
        Result::Error(_) => -1,
    };
}

test TotalPlusCountIsFifteen
{
    Testing.Assert.Equal(TotalPlusCount(), 15, "3 + 4 + 5 plus three scores");
}
