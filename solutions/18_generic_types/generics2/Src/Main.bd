// generics2
//
// Types can be generic too: `type Pair<A, B> { A first; B second; }`.
// Inside the type, `A` and `B` stand for whatever types the user picks:
// `Pair<string, i32> { first: "age", second: 42 }`. Methods use the same
// names for their parameter and return types.

use Core.Collections.Array;

type Pair<A, B>
{
    A first;
    B second;

    pub A First()
    {
        return this.first;
    }

    pub B Second()
    {
        return this.second;
    }

    pub Pair<B, A> Swapped()
    {
        return Pair<B, A>
        {
            first: this.second,
            second: this.first,
        };
    }
}

type Stack<T>
{
    T[] items;

    pub unit Push(mut this, T value)
    {
        this.items = Array.Append<T>(this.items, value);
    }

    pub i64 Size()
    {
        return Array.Len<T>(this.items);
    }

    pub T Top()
    {
        return this.items[Array.Len<T>(this.items) - 1];
    }
}

test PairKeepsBothTypes
{
    Pair<string, i32> age = Pair<string, i32>
    {
        first: "age",
        second: 42,
    };
    Testing.Assert.Equal(age.First(), "age", "first");
    Testing.Assert.Equal(age.Second(), 42, "second");
    Testing.Assert.Equal(age.Swapped().First(), 42, "swapped first");
}

test StackOfStrings
{
    mut Stack<string> words = Stack<string>
    {
        items: [],
    };
    words.Push("one");
    words.Push("two");
    Testing.Assert.Equal(words.Size(), 2, "two words");
    Testing.Assert.Equal(words.Top(), "two", "last pushed is on top");
}
