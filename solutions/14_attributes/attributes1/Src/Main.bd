// attributes1
//
// An attribute in square brackets gives the compiler extra facts about an item.
// `[Copyable]` says a type is plain data: it may be copied to another isolate.
// `[Immutable]` says nothing can change it, so isolates may share it.
// A parallel task may only capture values that are allowed to cross.

use Core.Parallel;
use Core.Parallel.Scopes;
use Core.Results;

[Copyable]
type Order {
    i64 quantity,
    i64 price,
}

i64 TotalInParallel(Order first, Order second) {
    Result<i64, ParallelError> result = Parallel.Scope<i64>((Core.Parallel.Scopes.Scope s) => {
        Task<i64> a = s.Spawn(() => first.quantity * first.price);
        Task<i64> b = s.Spawn(() => second.quantity * second.price);
        i64 left = match a.Join() { Result::Ok(value) => value, Result::Error(_) => 0_i64, };
        i64 right = match b.Join() { Result::Ok(value) => value, Result::Error(_) => 0_i64, };
        return Result::Ok(left + right);
    });
    return match result {
        Result::Ok(value) => value,
        Result::Error(_) => -1_i64,
    };
}

test totals_both_orders {
    Testing.Assert.Equal(TotalInParallel(Order { quantity: 2_i64, price: 10_i64 }, Order { quantity: 1_i64, price: 5_i64 }), 25_i64, "20 + 5");
}
