// hosts1
//
// Beskid wires an application together with a `host`. Its `registry` lists
// the services: `single PoliteGreeter for Greeter;` says "whenever someone
// needs a `Greeter`, give them the one `PoliteGreeter`". A type asks for a
// service with an `inject` field. `launch AppHost();` starts the host.
//
// The compiler checks the wiring: every `inject` must find a registration.
// This lesson is about the wiring the compiler checks; the `startup`, `init`
// and `dispose` hooks come in a later lesson.

contract Greeter
{
    string Greet(string name);
}

type PoliteGreeter : Greeter
{
    pub string Greet(string name)
    {
        return "Good morning, ${name}.";
    }
}

type Reception
{
    inject Greeter greeter;

    pub string Welcome(string name)
    {
        return this.greeter.Greet(name);
    }
}

host AppHost()
{
    registry
    {
        single PoliteGreeter for Greeter;
        single Reception;
    }
}

test HostWiringCompilesAndLaunches
{
    launch AppHost();
}
