// lists1
//
// `List<T>` from `Core.Collections.List` grows as you add items. `Push` adds an
// item to the end of the list in place: `items.Push("milk");`. The list must
// be declared `mut`, because pushing changes it.

use Core.Collections.List;
use Core.Results;

List<string> Shopping()
{
    mut List<string> items = List.New<string>();
    items.Push("bread");
    items.Push("milk");
    items.Push("apples");
    return items;
}

string ItemAt(List<string> items, i64 index)
{
    return match (items.Get(index))
    {
        Result::Ok(item) => item,
        Result::Error(message) => "",
    };
}

test ThreeItems
{
    List<string> items = Shopping();
    Testing.Assert.Equal(items.Count(), 3);
    Testing.Assert.Equal(ItemAt(items, 2), "apples", "apples come last");
}
