// generics1
//
// A generic function works for many types. Its type parameters follow the
// name in angle brackets: `T FirstOr<T>(T[] values, T fallback)`. The caller
// usually does not write `T`; the compiler infers it from the arguments.
// `where T: Named` limits `T` to types that conform to the contract `Named`,
// so the body may call `Name()` on a `T`.

use Core.Collections.Array;

pub contract Named
{
    string Name();
}

type Cat : Named
{
    string nickname;

    pub string Name()
    {
        return this.nickname;
    }
}

T FirstOr<T>(T[] values, T fallback)
{
    if (Array.Len<T>(values) == 0)
    {
        return fallback;
    }
    return values[0];
}

i64 CountEqual<T>(T[] values, T target)
{
    mut i64 count = 0;
    for value in values
    {
        if (value == target)
        {
            count = count + 1;
        }
    }
    return count;
}

string Label<T>(T item) where T: Named
{
    return "<${item.Name()}>";
}

test FirstOrWorksForNumbersAndStrings
{
    Testing.Assert.Equal(FirstOr([7, 8], 0), 7);
    Testing.Assert.Equal(FirstOr<string>([], "none"), "none", "empty array gives the fallback");
}

test CountEqual
{
    Testing.Assert.Equal(CountEqual(["a", "b", "a"], "a"), 2);
}

test LabelUsesTheContract
{
    Testing.Assert.Equal(Label(Cat
    {
        nickname: "Mruczek",
    }), "<Mruczek>", "label");
}
