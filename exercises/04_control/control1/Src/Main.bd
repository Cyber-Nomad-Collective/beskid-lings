// control1
//
// `if` / `else` choose a branch. `while` repeats while a condition holds.
// `for i in range(start, end)` counts from start up to, but not including, end.
//
// TODO: `Classify` forgets about zero, and `SumUpTo` stops one number too early.

string Classify(i32 value)
{
    if (value < 0)
    {
        return "negative";
    }
    return "positive";
}

i32 SumUpTo(i32 limit)
{
    mut i32 total = 0;
    for i in range(1, limit)
    {
        total = total + i;
    }
    return total;
}

test ClassifyValues
{
    Testing.Assert.Equal(Classify(-5), "negative");
    Testing.Assert.Equal(Classify(0), "zero");
    Testing.Assert.Equal(Classify(7), "positive");
}

test SumUpToTen
{
    Testing.Assert.Equal(SumUpTo(10), 55, "1 + 2 + ... + 10");
}
