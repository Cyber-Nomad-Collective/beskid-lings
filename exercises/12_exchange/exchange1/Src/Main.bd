// exchange1
//
// `exchange(place, value)` puts a new value into a field (or an array element)
// and gives you the old one back, in one step. It is the clean way to empty a
// field and keep what was in it.
//
// TODO: `Drain` returns the messages but leaves them in the inbox. Use
// `exchange` to swap in an empty array and return the old one.

type Inbox
{
    string[] messages;

    /// Empties the inbox and returns the messages it held.
    string[] Drain(mut this)
    {
        return this.messages;
    }
}

test DrainReturnsOldMessages
{
    mut Inbox inbox = Inbox
    {
        messages: ["hi", "lunch?"],
    };
    string[] old = inbox.Drain();
    Testing.Assert.Equal(Core.Collections.Array.Len<string>(old), 2, "two old messages");
    Testing.Assert.Equal(Core.Collections.Array.Len<string>(inbox.messages), 0, "inbox is empty");
}
