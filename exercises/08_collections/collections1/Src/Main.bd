// collections1
//
// `i32[]` is an array of i32. Write one as `[1, 2, 3]`, read an element with
// `values[0]`, and get the length with `Array.Len<i32>(values)`.
// `for value in values` visits every element in order.
//
// TODO: `Sum` never adds anything, and `Largest` is wrong when every number is
// negative.

use Core.Collections.Array;

i32 Sum(i32[] values)
{
    mut i32 total = 0;
    for value in values
    { }
    return total;
}

i32 Largest(i32[] values)
{
    mut i32 largest = 0;
    for value in values
    {
        if (value > largest)
        {
            largest = value;
        }
    }
    return largest;
}

test SumOfArray
{
    Testing.Assert.Equal(Sum([1, 2, 3, 4]), 10, "1 + 2 + 3 + 4");
}

test LargestElement
{
    Testing.Assert.Equal(Largest([3, 9, 2]), 9, "9 is the largest");
    Testing.Assert.Equal(Largest([-3, -9, -2]), -2, "-2 is the largest");
}

test LengthOfArray
{
    i32[] values = [5, 6, 7];
    Testing.Assert.Equal(Array.Len<i32>(values), 3, "three elements");
}
