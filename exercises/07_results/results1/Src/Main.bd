// results1
//
// Beskid has no exceptions. A function that can fail returns `Result<T, E>`:
// `Result::Ok(value)` or `Result::Error(error)`. The caller matches on it,
// or writes `?` to return the error to its own caller.
//
// TODO: `Divide` must refuse a zero divisor, and `Quarter` must unwrap the
// first division with `?`.

use Core.Results;

Result<i32, string> Divide(i32 dividend, i32 divisor)
{
    return Result::Ok(dividend / divisor);
}

/// Divides twice; the first error stops the calculation.
Result<i32, string> Quarter(i32 value)
{
    i32 half = Divide(value, 2);
    return Divide(half, 2);
}

string Describe(Result<i32, string> result)
{
    return match (result)
    {
        Result::Ok(value) => "ok ${value}",
        Result::Error(message) => "error: ${message}",
    };
}

test DivideOk
{
    Testing.Assert.Equal(Describe(Divide(10, 2)), "ok 5", "10 / 2");
}

test DivideByZero
{
    Testing.Assert.Equal(Describe(Divide(1, 0)), "error: cannot divide by zero", "1 / 0");
}

test QuarterUsesQuestionMark
{
    Testing.Assert.Equal(Describe(Quarter(20)), "ok 5", "20 / 2 / 2");
}
