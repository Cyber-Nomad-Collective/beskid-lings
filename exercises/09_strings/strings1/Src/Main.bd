// strings1
//
// `${expression}` inside a string literal inserts a value: "Hello, ${name}".
// `+` joins two strings. `Core.String` has helpers such as `String.Len`,
// `String.Trim` (drops spaces at both ends) and `String.Contains`.
//
// TODO: `Greeting` prints the words "name" and "unread" instead of their values,
// and `IsValidName` counts the spaces around the name.

use Core.String;

string Greeting(string name, i32 unread) {
    return "Hello, name! You have unread new messages.";
}

/// A user name is valid when it has at least 3 characters, not counting outer spaces.
bool IsValidName(string name) {
    return String.Len(name) >= 3_i64;
}

test GreetingUsesNameAndCount {
    Testing.Assert.Equal(Greeting("Ada", 2), "Hello, Ada! You have 2 new messages.", "greeting text");
}

test OuterSpacesDoNotCount {
    Testing.Assert.True(IsValidName("Ada"), "three letters");
    Testing.Assert.False(IsValidName("  a  "), "one letter with spaces around it");
}

test ContainsFindsAWord {
    Testing.Assert.True(String.Contains(Greeting("Ada", 2), "Ada"), "the name is in the greeting");
}
