// beskid-lings runner. Run it from the course folder:
//
//   beskid -q run --project Runner              watch mode with h/l/r/q commands
//   beskid -q run --project Runner -- verify    check every exercise in order
//   beskid -q run --project Runner -- list      every exercise and its status
//   beskid -q run --project Runner -- hint      hint for the current exercise

use Core.Args;
use Core.Collections.Array;
use Core.Results;
use Catalog;
use Checker;
use Report;
use State;
use Watch;

i32 Main()
{
    Result<Course, string> loaded = Catalog.Load("lings.json");
    return match (loaded)
    {
        Result::Error(message) => Fail(message),
        Result::Ok(course) => Dispatch(course, CommandName()),
    };
}

/// The first program argument, or "watch" when there is none.
string CommandName()
{
    return match (Args.Get(1))
    {
        Result::Ok(name) => name,
        Result::Error(error) => "watch",
    };
}

i32 Dispatch(Course course, string command)
{
    if (command == "watch")
    {
        return Watch.Run(course);
    }
    if (command == "verify")
    {
        return Verify(course);
    }
    if (command == "list")
    {
        Report.List(course, State.Load());
        return 0;
    }
    if (command == "hint")
    {
        Report.Hint(course, State.Load());
        return 0;
    }
    return Fail("unknown command `${command}`; use watch, verify, list or hint");
}

i32 Fail(string message)
{
    Core.Output.WriteLine("error: ${message}");
    return 2;
}

/// Checks every exercise in order, records the ones that pass, and stops at the first failure.
i32 Verify(Course course)
{
    mut string[] done = State.Load();
    i64 total = Array.Len<Exercise>(course.exercises);
    mut i64 index = 0;
    while (index < total)
    {
        Exercise exercise = course.exercises[index];
        CheckResult result = Checker.Run(exercise);
        if (!result.passed)
        {
            Report.Failure(exercise, result, index, total);
            Core.Output.WriteLine("Hint: ${exercise.hint}");
            return 1;
        }
        Core.Output.WriteLine("done ${exercise.name}");
        done = State.MarkDone(done, exercise.name);
        index = index + 1;
    }
    Report.Finished(course);
    return 0;
}
