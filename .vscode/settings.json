{
  // TEMPORARY: the Beskid extension turns on format-on-save (the intended
  // behaviour), but the 0.6.6 formatter deletes the comments at the top of a
  // file, which hold each exercise's instructions. Remove this block once a
  // build with the 0.6.7 formatter fix is installed.
  "[beskid]": {
    "editor.formatOnSave": false
  },
  // Build output: copied corelib sources, caches and lock files written by every
  // exercise check. Watching it makes the Beskid language server rescan the whole
  // course after each check, which delays completion and formatting.
  "files.watcherExclude": {
    "**/obj/**": true,
    "**/Project.lock": true
  },
  "files.exclude": {
    "**/obj": true,
    "**/Project.lock": true
  },
  "search.exclude": {
    "**/obj": true
  }
}
