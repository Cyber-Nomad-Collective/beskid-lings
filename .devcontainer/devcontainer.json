{
  "name": "beskid-lings",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-24.04",
  "remoteUser": "vscode",
  "remoteEnv": {
    "PATH": "/home/vscode/.local/bin:${containerEnv:PATH}"
  },
  "postCreateCommand": "bash .devcontainer/install-beskid.sh",
  "postAttachCommand": "bash .devcontainer/attach.sh",
  "customizations": {
    "vscode": {
      "settings": {
        "beskid.cli.path": "/home/vscode/.local/bin/beskid",
        "beskid.lsp.server.path": "/home/vscode/.beskid/toolchains/beskid-0.6.7-preview.3-x86_64-unknown-linux-gnu/bin/beskid_lsp"
      }
    },
    "codespaces": {
      "openFiles": [
        "README.md"
      ]
    }
  }
}
